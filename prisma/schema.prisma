datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
enum UserRole {
  CLIENTE
  BARBEIRO
  DONO
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  password  String
  role      UserRole @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointmentsAsClient Appointment[] @relation("AppointmentClient")
  appointmentsAsStaff  Appointment[] @relation("AppointmentStaff")
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  description  String
  price        Float
  duration     Int
  appointments Appointment[]
}

model Appointment {
  id              Int               @id @default(autoincrement())
  date            DateTime
  endDate         DateTime
  durationMinutes Int
  status          AppointmentStatus @default(CONFIRMED)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  clientId        Int?
  serviceId       Int
  adminId         Int?
  notes           String?
  admin           User?             @relation("AppointmentStaff", fields: [adminId], references: [id])
  client          User?             @relation("AppointmentClient", fields: [clientId], references: [id])
  service         Service           @relation(fields: [serviceId], references: [id])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model BusinessHours {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      @unique
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())
}
